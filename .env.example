PORT=3000
NODE_ENV=production
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info

# CORS: comma-separated allowed origins. Supports wildcard subdomains (e.g. *.biblehodl.com).
# Leave empty or set to * for open access.
CORS_ORIGINS=https://biblehodl.com,https://*.biblehodl.com

# API Keys: comma-separated valid API keys. Leave empty for open access (no auth required).
# Generate keys with: node -e "console.log('cpdv_' + require('crypto').randomBytes(24).toString('hex'))"
API_KEYS=
